{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/@sparticuz/**,node_modules/puppeteer-core/**,node_modules/@puppeteer/**}"
    }
  },
  "crons": [
    {
      "path": "/api/operations/process-jobs",
      "schedule": "0 4 * * *"
    }
  ]
}
