{
  "rewrites": [
    { "source": "/r/:id", "destination": "/api/index?route=r&id=:id" },
    { "source": "/cs/:file", "destination": "https://iiihikzsewdyhgmpsyaj.supabase.co/storage/v1/object/public/c-section-reports/:file" },
    { "source": "/sn/:file", "destination": "https://iiihikzsewdyhgmpsyaj.supabase.co/storage/v1/object/public/swar-name-reports/:file" },
    { "source": "/api/(.*)", "destination": "/api/index?route=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/@sparticuz/**,node_modules/puppeteer-core/**,node_modules/@puppeteer/**}"
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- src public api server index.html package.json package-lock.json bun.lock vite.config.ts tailwind.config.ts postcss.config.js tsconfig.json vercel.json components.json",
  "crons": [
    {
      "path": "/api/operations/process-jobs",
      "schedule": "0 4 * * *"
    }
  ]
}
